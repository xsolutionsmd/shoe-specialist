[Unit]
Description=Apply and verify the published shoe-specialist-abdul-dev application
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/shoe-specialist-abdul-dev-update
TimeoutStartSec=10min
TimeoutStopSec=2min
UMask=0077
